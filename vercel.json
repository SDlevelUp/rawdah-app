{
  "buildCommand": "if [ -n \"$CONVEX_DEPLOY_KEY\" ]; then npx convex deploy --cmd 'npm run build' --cmd-url-env-var-name VITE_CONVEX_URL; else npm run build; fi",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "muslim-dhikr-companion-main.vercel.app"
        }
      ],
      "destination": "https://rawdahapp.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "muslim-dhikr-companion-main.vercel.app"
        }
      ],
      "destination": "https://rawdahapp.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/_convex-site/:path*",
      "destination": "https://useful-anaconda-844.eu-west-1.convex.site/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
